# ============================================================================
# BTC CLOUD MINER — 環境変数テンプレート
#
# このファイルをコピーして .env.local を作り、値を入れてください。
#   cp .env.example .env.local
#
# ★ 重要 ★
#   - このファイルには実際の値を書かない（コミットされるため）
#   - 秘密鍵・ウォレットシードは、どの環境変数にも絶対に入れない
#   - 本番は Secrets Manager / Key Vault から注入すること
#
# すべて未設定でもアプリはデモモードで完全に動作します。
# ============================================================================

# ---------------------------------------------------------------------------
# 基本
# ---------------------------------------------------------------------------
# 未設定 → development
NODE_ENV=development

# アプリの公開 URL。未設定 → http://localhost:3000
APP_URL=http://localhost:3000

# 既定のサービス表示名。テナント設定があればそちらが優先される。
# 未設定 → "BTC CLOUD MINER"
APP_BRAND_NAME=BTC CLOUD MINER

# ---------------------------------------------------------------------------
# データベース
# ---------------------------------------------------------------------------
# 未設定 → インメモリストアで起動（デモデータ入り・再起動で消える）
# 設定時 → PostgreSQL を使用。接続に失敗した場合はインメモリへフォールバックし警告を出す
# 本番では必ず設定すること（サーバーレスにインメモリのままデプロイするとセッションが揮発する）
# DATABASE_URL=postgresql://user:password@localhost:5432/btc_cloud_miner?schema=public

# ---------------------------------------------------------------------------
# キャッシュ / レート制限
# ---------------------------------------------------------------------------
# 未設定 → インメモリ LRU（単一プロセスでのみ有効。複数インスタンスでは共有されない）
# REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# 暗号鍵（本番では必須）
# ---------------------------------------------------------------------------
# TOTP シークレット等のフィールド暗号化に使う 32 バイト鍵（hex 64 文字）
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 未設定 → 開発用の固定鍵が使われる（本番では起動時にエラーになる）
# ENCRYPTION_KEY=

# セッショントークンのハッシュに使うペッパー（任意・32バイト hex 推奨）
# 未設定 → ペッパーなしで SHA-256 のみ
# SESSION_PEPPER=

# ---------------------------------------------------------------------------
# マイニングプロバイダー
# ---------------------------------------------------------------------------
# mock  → MockMiningProvider のみを使う（既定。契約なしで全機能が動く）
# live  → DB に登録された実プロバイダーを使う（未登録なら mock にフォールバック）
# 未設定 → mock
MINING_PROVIDER_MODE=mock

# Mock が生成する契約ハッシュレートの規模（TH/s）。未設定 → 500
MOCK_HASHRATE_THS=500

# プロバイダー API のタイムアウト（ミリ秒）。未設定 → 10000
PROVIDER_TIMEOUT_MS=10000

# circuit breaker が開くまでの連続失敗回数。未設定 → 5
PROVIDER_FAILURE_THRESHOLD=5

# circuit breaker が開いている時間（ミリ秒）。未設定 → 60000
PROVIDER_BREAKER_RESET_MS=60000

# ワーカー統計の同期間隔（秒）。未設定 → 300（5分）
# 背景 worker（npm run worker）がこの間隔で同期する。将来は Cron/Queue へ差し替え可能
MINING_SYNC_INTERVAL_SEC=300

# LIVE スモークテスト（フェーズ20）。true のときだけ tests/live-smoke が実 API へ read-only 接続する。
# ★ CI では絶対に true にしないこと（CI は fixture のみでテストする）
# LIVE_PROVIDER_TEST=false

# ---------------------------------------------------------------------------
# 実プール接続の資格情報の例（credentialsRef → 環境変数名の対応）
# ---------------------------------------------------------------------------
# 管理画面でプロバイダーに credentialsRef を設定すると、対応する環境変数から値を読む。
#   参照名 "f2pool/account"  → 環境変数 F2POOL_ACCOUNT
#   参照名 "braiins/token"   → 環境変数 BRAIINS_TOKEN
# プール側では必ず read-only（統計閲覧のみ）のキー/トークンを発行すること。
# F2POOL_ACCOUNT=your-f2pool-account-name
# BRAIINS_TOKEN=your-braiins-readonly-token

# ---------------------------------------------------------------------------
# Stratum（マイニングプール接続）
# ---------------------------------------------------------------------------
# 未設定 → StratumAdapter は無効。Mock / REST のみで動作する
# ブラウザからは絶対に接続させず、必ず Backend Mining Gateway 経由にすること
# STRATUM_URL=stratum+tcp://pool.example.com:3333
# STRATUM_WORKER=youraccount.worker1
# STRATUM_PASSWORD=x
# Stratum のバージョン: v1 | v2（v2 は未実装。設計上の拡張点のみ）
STRATUM_VERSION=v1

# ---------------------------------------------------------------------------
# Bitcoin ネットワーク情報（複数ソース。上から順にフェイルオーバー）
# ---------------------------------------------------------------------------
# すべて未設定 → Mock ソース（現実的な値を返すが実データではない）
# 少なくとも 1 つ設定すれば実データを取得する
# BITCOIN_SOURCE_PRIMARY=https://mempool.space/api
# BITCOIN_SOURCE_SECONDARY=https://blockchain.info
# BITCOIN_SOURCE_TERTIARY=

# 自社フルノード（最も信頼できる。商用では推奨）
# BITCOIN_RPC_URL=http://127.0.0.1:8332
# BITCOIN_RPC_USER=
# BITCOIN_RPC_PASSWORD=

# ネットワーク情報のキャッシュ TTL（秒）。未設定 → 60
BITCOIN_CACHE_TTL_SEC=60

# 全ソース停止時に古い値を返す上限（秒）。未設定 → 86400（24時間）
BITCOIN_STALE_MAX_SEC=86400

# ---------------------------------------------------------------------------
# BTC 価格
# ---------------------------------------------------------------------------
# 未設定 → Mock 価格（デモ用。実勢と一致しない）
# PRICE_SOURCE_PRIMARY=https://api.coingecko.com/api/v3
# PRICE_SOURCE_SECONDARY=
# 価格キャッシュ TTL（秒）。未設定 → 60
PRICE_CACHE_TTL_SEC=60

# ---------------------------------------------------------------------------
# ウォレット / カストディ（3モード）
# ---------------------------------------------------------------------------
# mock    → 実送金なし・即時確認（デモ。既定）
# sandbox → 実送金なし・testnet アドレスのみ受理・意図的な失敗を再現（本番前リハーサル）
# live    → 外部カストディ経由の実送金。providers/custody.ts の実装が必須
#           （未実装のまま live を指定すると起動時に明示的にエラーになる）
# 未設定 → mock
WALLET_PROVIDER_MODE=mock

# 1回あたりの出金上限（BTC）。未設定 → 0.5
WITHDRAWAL_MAX_PER_TX_BTC=0.5
# ユーザーあたり24時間の出金上限（BTC）。未設定 → 1.0
WITHDRAWAL_DAILY_LIMIT_BTC=1.0

# カストディ API のエンドポイント。WALLET_PROVIDER_MODE=custody のとき必須
# CUSTODY_API_URL=
# カストディ API キーは Secrets Manager の参照名のみをここに書く（値を直接書かない）
# CUSTODY_API_KEY_REF=btc-cloud-miner/custody/api-key

# 出金機能の ON/OFF。インシデント時に false にして即座に止めるためのキルスイッチ
# 未設定 → true
FEATURE_WITHDRAWAL_ENABLED=true

# 最低出金額（BTC）。未設定 → 0.001
MIN_WITHDRAWAL_BTC=0.001
# 出金手数料（BTC）。未設定 → 0.00015
WITHDRAWAL_FEE_BTC=0.00015
# この額以下は 1 名承認。超えると 2 名承認（4-eyes）。未設定 → 0.01
WITHDRAWAL_TWO_APPROVER_THRESHOLD_BTC=0.01
# 新規登録アドレスへの送金を禁止する時間（時間）。未設定 → 24
WITHDRAWAL_ADDRESS_COOLDOWN_HOURS=24

# ---------------------------------------------------------------------------
# 手数料の既定値（テナント設定で上書きされる）
# ---------------------------------------------------------------------------
# プラットフォーム手数料率。未設定 → 0.02（2%）
DEFAULT_PLATFORM_FEE_RATE=0.02
# プール手数料率。未設定 → 0.02（2%）
DEFAULT_POOL_FEE_RATE=0.02
# 電力単価（USD/kWh）。未設定 → 0.06
DEFAULT_ELECTRICITY_PRICE_KWH=0.06

# ---------------------------------------------------------------------------
# Pilot Mode / Live 検証
# ---------------------------------------------------------------------------
# Pilot Mode: 実マイニングデータ・実Pool残高・実Payoutの管理は有効だが、
# 外部出金を全面禁止する（実BTC収益管理だけを安全に実証するモード）。未設定 → false
PILOT_MODE=false

# 実プールへの read-only 検証（npm run verify:f2pool）を許可するフラグ。
# CI では絶対に true にしないこと。未設定 → false（実APIへアクセスしない）
# LIVE_PROVIDER_TEST=true
# F2POOL_ACCOUNT_NAME=

# 本番起動ガードの緊急回避（致命的な設定不備でも起動する）。通常は使わない
# FORCE_START=true

# ---------------------------------------------------------------------------
# NiceHash Hashpower Arbitrage
# ---------------------------------------------------------------------------
# mock  → ネットワーク接続なしの擬似市場（既定）
# paper → 実市場データ（read-only 公開API）+ 仮想注文。★推奨の検証モード
# live  → 実注文。FEATURE_NICEHASH_TRADING_ENABLED=true が別途必須
NICEHASH_MODE=mock

# NiceHash API 資格情報（本番は Secrets Manager から注入）。
# 権限は Hashpower注文の View/Create/Manage のみ。★Withdrawal 権限は絶対に付与しない
# NICEHASH_API_KEY=
# NICEHASH_API_SECRET=
# NICEHASH_ORG_ID=

# ★ 実注文の Kill Switch。Paper/Backtest 検証が完了するまで false のまま（既定 false）
FEATURE_NICEHASH_TRADING_ENABLED=false

# 手数料フォールバック（API から取得できない場合。実測で要確認）
NICEHASH_MARKET_FEE_RATE=0.03
NICEHASH_ORDER_FEE_BTC=0.0001

# 判定パラメータ（管理画面からも変更可能。初期値は保守的に）
ARBITRAGE_SAFETY_MARGIN=0.10
ARBITRAGE_START_MARGIN=0.08
ARBITRAGE_STOP_MARGIN=0.03
ARBITRAGE_SCAN_INTERVAL_SEC=60
ARBITRAGE_MIN_RUNTIME_SEC=300
ARBITRAGE_MAX_RUNTIME_SEC=1800

# リスク上限（超過時は注文禁止）
ARBITRAGE_MAX_ORDER_BTC=0.005
ARBITRAGE_MAX_DAILY_SPEND_BTC=0.02
ARBITRAGE_MAX_DAILY_LOSS_BTC=0.005
ARBITRAGE_MAX_CONCURRENT_ORDERS=2
ARBITRAGE_MAX_HASHRATE_THS=2000
ARBITRAGE_MAX_DRAWDOWN_PERCENT=20

# 成功報酬率（実現純益のみ・High-Water Mark 併用）
ARBITRAGE_PERFORMANCE_FEE_RATE=0.2

# ---------------------------------------------------------------------------
# 管理者
# ---------------------------------------------------------------------------
# 管理画面にアクセスできる IP（カンマ区切り）。未設定 → 制限なし
# 本番では必ず設定すること
# ADMIN_IP_ALLOWLIST=203.0.113.10,203.0.113.11

# ---------------------------------------------------------------------------
# AI（任意）
# ---------------------------------------------------------------------------
# 未設定 → ルールベースの異常検知・推奨生成のみ（Mock）。機能は完全に動作する
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# 通知（商用版）
# ---------------------------------------------------------------------------
# 未設定 → アプリ内通知のみ。メールは送信されない
# SMTP_URL=
# MAIL_FROM=noreply@example.com

# ---------------------------------------------------------------------------
# 監視（任意）
# ---------------------------------------------------------------------------
# 未設定 → コンソールログのみ
# OTEL_EXPORTER_OTLP_ENDPOINT=
# LOG_LEVEL=info
