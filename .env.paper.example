# Paper 実運用の環境変数（docker-compose.paper.yml が読む）
#
#   cp .env.paper.example .env.paper
#   ★ .env.paper は .gitignore 済み。コミットしないこと。

# 必須: 新規生成した暗号鍵（開発用固定鍵での本番稼働は起動ガードが拒否する）
#   生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# 初回のみ使用: bootstrap で作る管理者（作成後この 2 行は消してよい）
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 任意: スキャン間隔（既定 60 秒。NiceHash Rate Limit を考慮し 60 未満にしない）
# ARBITRAGE_SCAN_INTERVAL_SEC=60

# ★ NiceHash API キーは paper では不要。live 移行まで設定しないこと。
# NICEHASH_API_KEY / NICEHASH_API_SECRET / NICEHASH_ORG_ID は空のままにする。
