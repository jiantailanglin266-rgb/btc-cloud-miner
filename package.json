{
  "name": "btc-cloud-miner",
  "version": "0.1.0",
  "private": true,
  "description": "BTC CLOUD MINER — Multi-tenant Bitcoin cloud mining management platform",
  "scripts": {
    "postinstall": "prisma generate || echo \"prisma generate skipped\"",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "demo:build": "node scripts/build-demo.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^16.2.12",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.7",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
